meta {
  name: Update Thesis - no autor
  type: http
  seq: 9
}

put {
  url: http://localhost:8000/api/thesis/1
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  Accept: application/json
  Authorization: Bearer {{director_token}}
}

body:json {
  {
    "title": "Intento de edición por no autor"
  }
}

tests {
  test("Status 403", function() {
    expect(res.status).to.equal(403);
  });
  test("Not author message", function() {
    expect(res.body.message).to.equal("No eres el autor de esta tesis.");
  });
}
