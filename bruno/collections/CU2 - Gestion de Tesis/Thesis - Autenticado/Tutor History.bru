meta {
  name: Tutor History
  type: http
  seq: 8
}

get {
  url: http://localhost:8000/api/thesis/1/tutor/history
  body: none
  auth: bearer
}

headers {
  Accept: application/json
  Authorization: Bearer {{director_token}}
}

tests {
  test("Status 200", function() {
    expect(res.status).to.equal(200);
  });
  test("Returns data array", function() {
    expect(res.body).to.have.property("data");
    expect(res.body.data).to.be.an("array");
  });
  test("Each log has required fields", function() {
    if (res.body.data.length > 0) {
      var log = res.body.data[0];
      expect(log).to.have.property("id");
      expect(log).to.have.property("action");
      expect(log).to.have.property("created_at");
      expect(log).to.have.property("previous_tutor");
      expect(log).to.have.property("new_tutor");
      expect(log).to.have.property("changed_by");
    }
  });
  test("Actions are valid", function() {
    res.body.data.forEach(function(log) {
      expect(["assigned", "removed", "changed"]).to.include(log.action);
    });
  });
}
