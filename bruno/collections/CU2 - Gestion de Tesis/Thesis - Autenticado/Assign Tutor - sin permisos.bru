meta {
  name: Assign Tutor - sin permisos
  type: http
  seq: 6
}

put {
  url: http://localhost:8000/api/thesis/1/tutor
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  Accept: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {
    "user_id": 4
  }
}

tests {
  test("Status 403", function() {
    expect(res.status).to.equal(403);
  });
  test("Forbidden message", function() {
    expect(res.body.message).to.equal("Forbidden");
  });
}
